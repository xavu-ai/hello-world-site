# ============================================================
# Standard .gitignore for OpenClaw AI team project repos
# Copy this to the root of every project repo as .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
eggs/
*.whl
.eggs/
pip-log.txt
pip-delete-this-directory.txt
*.pyo
*.pdb
develop-eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.python-version
.pdm.toml
.pdm-python
pdm.lock

# Python tools
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
*.cover
*.py,cover
.pytype/
celerybeat-schedule
celerybeat.pid

# ---- Node.js / Frontend ----
node_modules/
.next/
out/
.nuxt/
.cache/
.turbo/
.vercel/
.output/
*.tsbuildinfo
.eslintcache
.stylelintcache
.parcel-cache/
.svelte-kit/
.docusaurus/
storybook-static/
.storybook/out/

# Next.js specific
.next/
.env*.local
next-env.d.ts

# Build output
dist/
build/
.build/
coverage/
*.lcov

# Package manager
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
lerna-debug.log*

# ---- Docker ----
docker-compose.override.yml
*.pid

# ---- IDE / Editor ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.sublime-project
*.sublime-workspace
*.code-workspace

# ---- Environment / Secrets ----
.env
.env.local
.env.*.local
!.env.example
!.env.template
*.pem
*.key
*.cert

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
$RECYCLE.BIN/

# ---- Lock files ----
uv.lock
package-lock.json
pnpm-lock.yaml
yarn.lock
poetry.lock
Pipfile.lock

# ---- Testing / Coverage ----
coverage/
*.lcov
.nyc_output/
junit.xml
test-results/
playwright-report/
test-report/

# ---- Misc build artifacts ----
*.log
logs/
tmp/
temp/
.cache/
*.tgz
*.tar.gz
*.map
